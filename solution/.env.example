# Klucz potrzebny tylko dla Mistral La Plateforme (patrz config/model.yaml).
MISTRAL_API_KEY=
# Katalog z danymi treningowymi (dane/przyklad_XX/*.json) dla scorera i części testów.
DATA_DIR=
# Port formularza WWW (python -m app --serve).
PORT=8000
# Klucz RunPod do modelu Bielik w chmurze (patrz config/model.yaml i /opt/RUN.md).
RUNPOD_API_KEY=
# ID endpointu RunPod Serverless (adres: https://api.runpod.ai/v2/<ID>/openai/v1).
RUNPOD_ENDPOINT_ID=
