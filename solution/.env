# Ustawienia programu. Wpisz wartości po znaku "=" i zapisz plik.
# NIE wysyłaj tego pliku z wpisanym kluczem do repozytorium (git commit / push).

# Klucz RunPod do modelu Bielik (zaczyna się od rpa_). Dostajesz go od autorów projektu.
RUNPOD_API_KEY=
# ID endpointu RunPod Serverless (adres: https://api.runpod.ai/v2/<ID>/openai/v1).
RUNPOD_ENDPOINT_ID=

# Katalog z danymi treningowymi (dane/przyklad_XX/*.json) dla scorera i części testów.
DATA_DIR=
# Port formularza WWW (python -m app --serve).
PORT=8000
